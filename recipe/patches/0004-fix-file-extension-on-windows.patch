From 70217c9066be99ed7a2bf10d9c76e99933cf8154 Mon Sep 17 00:00:00 2001
From: "H. Vetinari" <h.vetinari@gmx.com>
Date: Mon, 2 Mar 2026 13:39:13 +1100
Subject: [PATCH 4/4] fix file extension on windows

---
 lldb/bindings/python/get-python-config.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lldb/bindings/python/get-python-config.py b/lldb/bindings/python/get-python-config.py
index bf8cc48b013e..5343b467a402 100755
--- a/lldb/bindings/python/get-python-config.py
+++ b/lldb/bindings/python/get-python-config.py
@@ -72,7 +72,7 @@ def main():
                     sys.exit(1)
     elif args.variable_name == "LLDB_PYTHON_EXT_SUFFIX":
         if args.stable_abi:
-            print(".abi3%s" % sysconfig.get_config_var("SHLIB_SUFFIX"))
+            print(".abi3.%s" % sysconfig.get_config_var("EXT_SUFFIX").split(".")[-1])
         else:
             print(sysconfig.get_config_var("EXT_SUFFIX"))
     else:
